# === DeepSeek ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# === 网易云音乐 ===
# 浏览器登录 music.163.com → F12 → Application → Cookies → 复制全部
NCM_COOKIE=MUSIC_U=your-cookie-value

# === MiMo TTS (小米) ===
MIMO_API_KEY=sk-your-mimo-key
# 男声音色: 白桦(温暖成熟有故事感) / 苏打(清爽年轻)
# 女声音色: 冰糖(默认) / 茉莉
MIMO_VOICE_ID=白桦

# === Fish Audio TTS (MiMo 失败时备用) ===
FISH_AUDIO_KEY=your-fish-audio-key
FISH_AUDIO_REFERENCE_ID=6f3aa0f9c0a641b4a0f731305c74e0b1
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_PROXY=http://127.0.0.1:7892
FISH_AUDIO_ALLOW_MIMO_FALLBACK=true

# === 和风天气 ===
HEFENG_API_KEY=your-hefeng-key
HEFENG_CITY=上海

# === 服务器 ===
PORT=8080
HOST=0.0.0.0
